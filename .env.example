# Public site URL used for canonical metadata, JSON-LD, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://saifulshuvo.com

# WordPress CMS/backend. These values are read only during the static build.
WORDPRESS_URL=https://cms.saifulshuvo.com
WORDPRESS_GRAPHQL_URL=https://cms.saifulshuvo.com/graphql

# Browser-facing REST endpoint used by ContactForm and AnalyticsManager.
NEXT_PUBLIC_WORDPRESS_REST_URL=https://cms.saifulshuvo.com/wp-json/saifulshuvo/v1

# Optional emergency-only fallback for homepage copy during development.
# Keep false for release builds so a broken WordPress schema fails the build visibly.
WORDPRESS_ALLOW_FALLBACK=false
