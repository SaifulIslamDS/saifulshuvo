# Public portfolio URL. Use the Netlify production URL until the custom domain is connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Settings -> API / Connect dialog
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only allow-list. This must be the exact Google account used for admin login.
# Add the same email to private.admin_allowlist after applying the migration.
ADMIN_EMAIL=your-google-account@example.com
