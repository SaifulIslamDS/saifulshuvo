NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Preferred: comma-separated Google accounts. Every address must also exist
# in private.admin_allowlist in Supabase.
ADMIN_EMAILS=first@gmail.com,second@gmail.com

# Backward-compatible single-admin variable; optional when ADMIN_EMAILS is set.
# ADMIN_EMAIL=first@gmail.com

# v0.8.0 contact inbox and email notifications
# Resend API key. Keep server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxx

# Verified sender identity, for example:
# CONTACT_FROM_EMAIL=Saiful Islam Portfolio <contact@saifulshuvo.com>
CONTACT_FROM_EMAIL=Portfolio <contact@your-verified-domain.com>

# One or more comma-separated notification recipients.
CONTACT_NOTIFICATION_TO=your-email@example.com

# Random server-only secret used to hash request fingerprints for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_FINGERPRINT_SECRET=replace-with-a-random-secret
