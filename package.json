{
  "name": "saifulshuvo-portfolio",
  "version": "1.0.0-rc.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev",
    "clean": "node scripts/clean-next-cache.mjs",
